<?xml version="1.0" encoding="utf-8" ?>
<component name="MusicScene" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/MusicScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0xF0F2F5FF" />

        <!-- Header -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0xFFFFFFFF" />
            <Rectangle width="1920" height="1" color="0xE2E8F0FF" translation="[0, 89]" />
            <Rectangle width="1920" height="3" color="0xFF6B6BFF" translation="[0, 87]" />
            
            <Label text="FamilyCare TV" font="font:MediumBoldSystemFont" color="0x00C9A7FF" translation="[80, 28]" />
            <Label text="Music &amp; Relaxing Audio Library" font="font:MediumBoldSystemFont" color="0x0F172AFF" translation="[340, 28]" width="1200" />
        </Group>

        <!-- Main Player & Playlist Layout -->
        <Group translation="[80, 120]">

            <!-- Left Panel: Now Playing Card -->
            <Group translation="[0, 0]">
                <Rectangle width="644" height="854" color="0xE2E8F0FF" translation="[-2, -2]" cornerRoundingRadius="12" />
                <Rectangle width="640" height="850" color="0xFFFFFFFF" cornerRoundingRadius="12" />
                <Rectangle width="640" height="4" color="0xFF6B6BFF" />

                <!-- Album Art Card -->
                <Rectangle width="440" height="330" color="0xFF6B6B15" translation="[100, 35]" cornerRoundingRadius="8" />
                <Poster id="albumArtPoster" width="440" height="330" translation="[100, 35]"
                    loadDisplayMode="scaleToFit" uri="pkg:/images/icon_music.png" />

                <!-- Dynamic Track Info Stack (Vertical LayoutGroup) -->
                <LayoutGroup id="nowPlayingStack" layoutDirection="vert"
                    translation="[40, 390]" itemSpacings="[8]">
                    <Label id="trackTitle" text="Relaxing Piano Melodies"
                        font="font:LargeBoldSystemFont" color="0x0F172AFF"
                        horizAlign="center" width="560" wrap="true" maxLines="2" />

                    <Label id="trackArtist" text="FamilyCare Wellness Music"
                        font="font:MediumSystemFont" color="0x64748BFF"
                        horizAlign="center" width="560" wrap="false" maxLines="1" />
                </LayoutGroup>

                <!-- Audio Progress Bar -->
                <Group translation="[60, 520]">
                    <Rectangle width="520" height="8" color="0xE2E8F0FF" cornerRoundingRadius="4" />
                    <Rectangle id="progressBar" width="210" height="8" color="0xFF6B6BFF" cornerRoundingRadius="4" />
                    <Label id="timeElapsed" text="01:45" font="font:SmallSystemFont" color="0x64748BFF" translation="[0, 18]" />
                    <Label id="timeTotal" text="04:20" font="font:SmallSystemFont" color="0x64748BFF" translation="[460, 18]" />
                </Group>

                <!-- Audio Control Buttons Row -->
                <Group id="controlsGroup" translation="[110, 610]">
                    <!-- Prev Button -->
                    <Group id="prevBtn" translation="[0, 0]">
                        <Rectangle id="prevFocusBorder" width="104" height="64" color="0xFF6B6BFF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                        <Rectangle width="102" height="62" color="0xE2E8F0FF" translation="[-1, -1]" cornerRoundingRadius="8" />
                        <Rectangle width="100" height="60" color="0xF1F5F9FF" cornerRoundingRadius="8" />
                        <Label text="◄◄" font="font:MediumBoldSystemFont" color="0x0F172AFF" horizAlign="center" width="100" translation="[0, 15]" />
                    </Group>

                    <!-- Play / Pause Button -->
                    <Group id="playBtn" translation="[120, 0]">
                        <Rectangle id="playFocusBorder" width="184" height="64" color="0xFF6B6BFF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                        <Rectangle id="playBg" width="180" height="60" color="0xFF6B6BFF" cornerRoundingRadius="8" />
                        <Label id="playLabel" text="❚❚ Pause" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="180" translation="[0, 15]" />
                    </Group>

                    <!-- Next Button -->
                    <Group id="nextBtn" translation="[320, 0]">
                        <Rectangle id="nextFocusBorder" width="104" height="64" color="0xFF6B6BFF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                        <Rectangle width="102" height="62" color="0xE2E8F0FF" translation="[-1, -1]" cornerRoundingRadius="8" />
                        <Rectangle width="100" height="60" color="0xF1F5F9FF" cornerRoundingRadius="8" />
                        <Label text="►►" font="font:MediumBoldSystemFont" color="0x0F172AFF" horizAlign="center" width="100" translation="[0, 15]" />
                    </Group>
                </Group>

                <Label text="Press OK to Play / Pause active track" font="font:SmallSystemFont" color="0x94A3B8FF" translation="[40, 760]" width="560" horizAlign="center" />
            </Group>

            <!-- Right Panel: Playlist Tracks Grid -->
            <Group translation="[680, 0]">
                <Rectangle width="1084" height="854" color="0xE2E8F0FF" translation="[-2, -2]" cornerRoundingRadius="12" />
                <Rectangle width="1080" height="850" color="0xFFFFFFFF" cornerRoundingRadius="12" />
                <Rectangle width="1080" height="4" color="0x00C9A7FF" />

                <Label text="Select Playlist Track" font="font:MediumBoldSystemFont" color="0x0F172AFF" translation="[40, 25]" width="1000" />

                <Label id="emptyState" text="No music tracks available in your library." font="font:MediumSystemFont" color="0x64748BFF" translation="[40, 200]" width="1000" horizAlign="center" visible="false" />

                <MarkupGrid id="playlistGrid"
                    translation="[40, 70]"
                    itemComponentName="MusicTrackTile"
                    itemSize="[485, 175]"
                    itemSpacing="[20, 16]"
                    numColumns="2"
                    numRows="4"
                    drawFocusFeedback="false" />
            </Group>
        </Group>

        <!-- Safe-Area Footer Bar -->
        <Group id="footerGroup" translation="[0, 1008]">
            <Rectangle width="1920" height="52" color="0xFFFFFFFF" />
            <Rectangle width="1920" height="1" color="0xE2E8F0FF" translation="[0, 0]" />
            <Label text="Back Return to Dashboard  |  OK Play Selected Track  |  ◄ Left / ► Right Audio Controls"
                font="font:SmallSystemFont" color="0x64748BFF" translation="[80, 14]" width="1760" />
        </Group>

        <!-- Services & Audio Player -->
        <Audio id="audioPlayer" />
        <ApiTask id="musicTask" />
        <ErrorDialog id="errorDialog" />

        <Group id="loadingOverlay" visible="true">
            <LoadingSpinner translation="[930, 480]" />
        </Group>
    </children>
</component>
