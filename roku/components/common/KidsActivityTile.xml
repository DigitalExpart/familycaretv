<?xml version="1.0" encoding="utf-8" ?>
<component name="KidsActivityTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="OnItemContentChange" />
        <field id="itemHasFocus" type="boolean" value="false" onChange="OnItemFocusChange" />
        <field id="width" type="float" value="415" />
        <field id="height" type="float" value="270" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/common/KidsActivityTile.brs" />
    <children>
        <Group id="scaleContainer" scaleRotateCenter="[207.5, 135]">
            <!-- Focus glow (behind card) -->
            <Rectangle id="focusGlow" width="419" height="274" color="0x7E57C250"
                translation="[-2, -2]" visible="false" cornerRoundingRadius="12" />

            <!-- Card border -->
            <Rectangle id="cardBorder" width="415" height="270" color="0xE2E8F0FF"
                cornerRoundingRadius="12" />

            <!-- Card background -->
            <Rectangle id="cardBg" width="411" height="266" color="0xFFFFFFFF"
                translation="[2, 2]" cornerRoundingRadius="12" />

            <!-- Top accent bar -->
            <Rectangle id="accentBar" width="411" height="4" color="0x7E57C2FF"
                translation="[2, 2]" />

            <!-- Bounded Dynamic Vertical Flow (No horizAlignment=center on LayoutGroup) -->
            <LayoutGroup id="contentStack" layoutDirection="vert"
                translation="[24, 24]" itemSpacings="[14, 10, 10]">

                <!-- Activity Icon: Centered in 367px content width: (367 - 48) / 2 = 159 -->
                <Poster id="icon" width="48" height="48" translation="[159, 0]"
                    uri="pkg:/images/icon_kids.png" loadDisplayMode="scaleToFit" />

                <!-- Activity Title (Centered via Label horizAlign inside 367px) -->
                <Label id="titleLabel"
                    font="font:MediumBoldSystemFont"
                    color="0x0F172AFF"
                    horizAlign="center"
                    width="367"
                    wrap="true"
                    maxLines="2" />

                <!-- Activity Description (Centered via Label horizAlign inside 367px) -->
                <Label id="descLabel"
                    font="font:SmallSystemFont"
                    color="0x64748BFF"
                    horizAlign="center"
                    width="367"
                    wrap="true"
                    maxLines="3" />
            </LayoutGroup>
        </Group>

        <!-- Focus scale animation -->
        <Animation id="focusInAnim" duration="0.15" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator
                key="[0.0, 1.0]"
                keyValue="[ [1.0, 1.0], [1.03, 1.03] ]"
                fieldToInterp="scaleContainer.scale" />
        </Animation>

        <Animation id="focusOutAnim" duration="0.15" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator
                key="[0.0, 1.0]"
                keyValue="[ [1.03, 1.03], [1.0, 1.0] ]"
                fieldToInterp="scaleContainer.scale" />
        </Animation>
    </children>
</component>
