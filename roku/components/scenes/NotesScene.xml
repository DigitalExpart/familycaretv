<?xml version="1.0" encoding="utf-8" ?>
<component name="NotesScene" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/NotesScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x121212FF" />

        <!-- Header -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0x1E1E1EFF" />
            <Rectangle width="1920" height="3" color="0x008F86FF" translation="[0, 87]" />
            
            <Label text="Personal &amp; Care Notes" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[340, 30]" />

            <!-- [+] Add Note Button -->
            <Group id="addBtnGroup" translation="[1600, 18]">
                <Rectangle id="addBtnFocusBorder" width="264" height="54" color="0x008F86FF" translation="[-2, -2]" visible="false" />
                <Rectangle id="addBtnBg" width="260" height="50" color="0x008F86FF" />
                <Label text="✚ Add Note" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="260" translation="[0, 12]" />
            </Group>
        </Group>

        <!-- Notes Grid -->
        <MarkupGrid id="notesGrid"
            translation="[80, 140]"
            itemComponentName="QuickActionTile"
            itemSize="[415, 175]"
            itemSpacing="[20, 20]"
            numColumns="4"
            numRows="5"
            drawFocusFeedback="false"
            visible="false" />

        <!-- Empty State -->
        <Group id="emptyState" visible="false" translation="[560, 360]">
            <Rectangle width="800" height="260" color="0x1E1E1EFF" />
            <Rectangle width="800" height="4" color="0x008F86FF" />
            <Label text="No Personal Notes" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" translation="[40, 40]" />
            <Label text="Store caregiver reminders, medical updates, and family memos here." font="font:MediumSystemFont" color="0xAAAAAAFF" translation="[40, 95]" />
            <Label text="Click [+ Add Note] to create your first note entry." font="font:SmallSystemFont" color="0x8E8EA0FF" translation="[40, 150]" />
        </Group>

        <!-- Footer -->
        <Rectangle width="1920" height="36" color="0xE8EBF0FF" translation="[0, 1044]" />
        <Label text="Back Return  |  OK Edit Note  |  * Options Delete  |  ▲ Up to Add Button"
            font="font:SmallSystemFont" color="0x8E8EA0FF" translation="[80, 1050]" />

        <!-- Services -->
        <ApiTask id="notesTask" />
        <ApiTask id="deleteTask" />
        <ErrorDialog id="errorDialog" />

        <ConfirmDialog id="confirmDeleteDialog" title="Delete Note" message="Are you sure you want to delete this note?" confirmText="Yes, Delete" cancelText="Cancel" />

        <Group id="loadingOverlay" visible="true">
            <LoadingSpinner translation="[930, 480]" />
            <Label text="Loading notes..." font="font:MediumSystemFont" color="0xAAAAAAFF" horizAlign="center" width="1920" translation="[0, 560]" />
        </Group>
    </children>
</component>
