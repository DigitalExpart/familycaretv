<?xml version="1.0" encoding="utf-8" ?>
<component name="QuickActionTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="OnItemContentChange" />
        <field id="itemHasFocus" type="boolean" value="false" onChange="OnItemFocusChange" />
        <field id="width" type="float" value="415" />
        <field id="height" type="float" value="175" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/common/QuickActionTile.brs" />
    <children>
        <Group id="scaleContainer" translation="[207.5, 87.5]">
            <!-- Everything is translated back to be centered around [0,0] for proper scaling -->
            
            <!-- Focus glow (behind everything, shown on focus) -->
            <Rectangle id="focusGlow" width="419" height="179" color="0x00A89D50"
                translation="[-209.5, -89.5]" visible="false" />

            <!-- Card shadow (animated opacity) -->
            <Rectangle id="shadow" width="409" height="169" color="0x0000000D"
                translation="[-201.5, -81.5]" opacity="0.3" />

            <!-- Card background -->
            <Rectangle id="cardBg" width="405" height="165" color="0x242424FF"
                translation="[-203.5, -83.5]" />

            <!-- Left accent bar -->
            <Rectangle id="accentBar" width="5" height="165" color="0x00A89DFF"
                translation="[-203.5, -83.5]" />

            <!-- Icon (centered horizontally) -->
            <Poster id="icon" width="48" height="48"
                translation="[-24.5, -71.5]"
                loadDisplayMode="scaleToFit" />

            <!-- Title (centered) -->
            <Label id="titleLabel"
                font="font:MediumBoldSystemFont"
                color="0xFFFFFFFF"
                horizAlign="center"
                translation="[-207.5, -13.5]"
                width="415" />

            <!-- Subtitle (centered) -->
            <Label id="descLabel"
                font="font:SmallSystemFont"
                color="0x8E8EA0FF"
                horizAlign="center"
                translation="[-207.5, 24.5]"
                width="415" />
        </Group>

        <!-- Focus scale animation -->
        <Animation id="focusInAnim" duration="0.15" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="scaleUpInterp"
                key="[0.0, 1.0]"
                keyValue="[ [1.0, 1.0], [1.08, 1.08] ]"
                fieldToInterp="scaleContainer.scale" />
            <FloatFieldInterpolator id="shadowOpUpInterp"
                key="[0.0, 1.0]"
                keyValue="[ 0.3, 0.8 ]"
                fieldToInterp="shadow.opacity" />
        </Animation>

        <Animation id="focusOutAnim" duration="0.15" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="scaleDownInterp"
                key="[0.0, 1.0]"
                keyValue="[ [1.08, 1.08], [1.0, 1.0] ]"
                fieldToInterp="scaleContainer.scale" />
            <FloatFieldInterpolator id="shadowOpDownInterp"
                key="[0.0, 1.0]"
                keyValue="[ 0.8, 0.3 ]"
                fieldToInterp="shadow.opacity" />
        </Animation>
    </children>
</component>
