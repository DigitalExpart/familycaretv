<?xml version="1.0" encoding="utf-8" ?>
<component name="ConfirmDialog" extends="Group">
    <interface>
        <field id="title" type="string" value="Confirm Action" onChange="OnTextChange" />
        <field id="message" type="string" value="Are you sure you want to proceed?" onChange="OnTextChange" />
        <field id="confirmText" type="string" value="Yes, Delete" onChange="OnTextChange" />
        <field id="cancelText" type="string" value="Cancel" onChange="OnTextChange" />
        <field id="confirmed" type="boolean" value="false" alwaysNotify="true" />
        <field id="cancelled" type="boolean" value="false" alwaysNotify="true" />
        <field id="show" type="boolean" value="false" onChange="OnShowChange" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/common/ConfirmDialog.brs" />
    <children>
        <!-- Overlay backdrop -->
        <Rectangle width="1920" height="1080" color="0x00000066" />

        <!-- Dialog Card (White surface with subtle border) -->
        <Group translation="[560, 340]">
            <Rectangle width="804" height="364" color="0xE2E8F0FF" translation="[-2, -2]" cornerRoundingRadius="12" />
            <Rectangle width="800" height="360" color="0xFFFFFFFF" cornerRoundingRadius="12" />
            <Rectangle width="800" height="4" color="0xEF4444FF" />

            <LayoutGroup layoutDirection="vert" translation="[40, 30]" itemSpacings="[14]">
                <Label id="titleLabel" text="Confirm Action"
                    font="font:LargeBoldSystemFont" color="0x0F172AFF"
                    width="720" />

                <Label id="messageLabel" text="Are you sure?"
                    font="font:MediumSystemFont" color="0x64748BFF"
                    width="720" wrap="true" maxLines="4" />
            </LayoutGroup>

            <!-- Buttons Row -->
            <Group id="btnGroup" translation="[40, 260]">
                <!-- Confirm Button (Red) -->
                <Group id="confirmBtn" translation="[0, 0]">
                    <Rectangle id="confirmFocusBorder" width="344" height="64" color="0xEF4444FF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                    <Rectangle id="confirmBg" width="340" height="60" color="0xEF4444FF" cornerRoundingRadius="8" />
                    <Label id="confirmLabel" text="Yes, Delete"
                        font="font:MediumBoldSystemFont" color="0xFFFFFFFF"
                        horizAlign="center" width="340" translation="[0, 15]" />
                </Group>

                <!-- Cancel Button (Light Gray with Dark Text) -->
                <Group id="cancelBtn" translation="[380, 0]">
                    <Rectangle id="cancelFocusBorder" width="224" height="64" color="0x00C9A7FF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                    <Rectangle id="cancelBorder" width="222" height="62" color="0xE2E8F0FF" translation="[-1, -1]" cornerRoundingRadius="8" />
                    <Rectangle id="cancelBg" width="220" height="60" color="0xF1F5F9FF" cornerRoundingRadius="8" />
                    <Label id="cancelLabel" text="Cancel"
                        font="font:MediumBoldSystemFont" color="0x0F172AFF"
                        horizAlign="center" width="220" translation="[0, 15]" />
                </Group>
            </Group>
        </Group>
    </children>
</component>
