<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeSceneV2" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/HomeSceneV2.brs" />

    <children>
        <!-- Background -->
        <Rectangle width="1920" height="1080" color="0x08080EFF" />

        <!-- ========================================== -->
        <!-- SIDEBAR NAVIGATION RAIL                    -->
        <!-- ========================================== -->
        <Group id="sidebarGroup">
            <Rectangle width="240" height="1080" color="0x040408FF" />
            
            <!-- Right border -->
            <Rectangle width="1" height="1080" color="0x0D0D18FF" translation="[239, 0]" />

            <!-- Logo area -->
            <Label text="FamilyCare TV" font="font:LargeBoldSystemFont" color="0x00C9A7FF" translation="[24, 40]" />
            <Label text="HEALTH · WELLNESS · FAMILY" font="font:SmallSystemFont" color="0x1E3A34FF" translation="[24, 76]" />

            <Rectangle width="192" height="1" color="0x0D0D18FF" translation="[24, 108]" />

            <!-- Nav Items List -->
            <MarkupGrid id="sidebarNav"
                translation="[0, 130]"
                itemComponentName="SidebarNavItem"
                itemSize="[240, 52]"
                itemSpacing="[0, 4]"
                numColumns="1"
                numRows="9"
                drawFocusFeedback="false" />

            <!-- Notification Bell & Profile -->
            <Group translation="[0, 1020]">
                <Rectangle width="192" height="1" color="0x0D0D18FF" translation="[24, -2]" />
                
                <!-- Notification Bell -->
                <Group id="navBell" translation="[30, 10]">
                    <Poster width="28" height="28" uri="pkg:/images/icon_notifications.png" blendColor="0x475569FF" />
                    <!-- Red dot badge -->
                    <Rectangle id="navBadge" width="10" height="10" color="0xEF4444FF" translation="[20, -2]" visible="false" />
                </Group>

                <!-- User Profile -->
                <Group translation="[172, 6]">
                    <Rectangle width="38" height="38" color="0x1A3D35FF" translation="[-1, -1]" />
                    <Rectangle width="36" height="36" color="0x111825FF" />
                    <Label text="J" font="font:SmallBoldSystemFont" color="0x00C9A7FF" translation="[12, 6]" />
                </Group>
            </Group>
        </Group>

        <!-- ========================================== -->
        <!-- MAIN CONTENT AREA                          -->
        <!-- ========================================== -->
        <Group id="mainContent" translation="[240, 0]">
            
            <!-- HEADER ROW -->
            <Label id="greetingLabel" text="Good morning, Jumat" font="font:LargeBoldSystemFont" color="0xE2E8F0FF" translation="[40, 40]" />
            <Label id="dateLabel" text="Friday, 31 July 2026" font="font:MediumSystemFont" color="0x334155FF" translation="[40, 94]" />

            <!-- Clock -->
            <Label id="clockLabel" text="5:57 AM" font="font:LargeSystemFont" color="0x94A3B8FF" translation="[1480, 40]" width="150" horizAlign="right" />
            <Label id="clockSuffixLabel" text="EN" font="font:SmallSystemFont" color="0x1E293BFF" translation="[1480, 82]" width="150" horizAlign="right" />

            <!-- APPOINTMENT ALERT BAR -->
            <Group id="alertBar" translation="[40, 140]">
                <Rectangle width="1602" height="54" color="0x3D2E09FF" translation="[-1, -1]" />
                <Rectangle width="1600" height="52" color="0x0D1407FF" />
                <Poster width="20" height="20" uri="pkg:/images/icon_calendar.png" blendColor="0xF59E0BFF" translation="[18, 17]" />
                <Label text="Upcoming — Dr. Sarah Johnson (Cardiology) · Today at 2:30 PM" font="font:MediumSystemFont" color="0x64748BFF" translation="[48, 14]" />
                <Label text="In 4 hours →" font="font:MediumSystemFont" color="0xF59E0BFF" translation="[1480, 14]" />
            </Group>

            <!-- STATS ROW -->
            <Group id="statsStrip" translation="[40, 222]">
                <!-- Stat 1: Patients -->
                <Group translation="[0, 0]">
                    <Rectangle width="382" height="112" color="0x0F0F17FF" translation="[-1, -1]" />
                    <Rectangle width="380" height="110" color="0x0C0C13FF" />
                    <Label id="statPatients" text="3" font="font:LargeBoldSystemFont" color="0x00C9A7FF" translation="[24, 18]" />
                    <Rectangle width="32" height="3" color="0x00C9A7B3" translation="[24, 76]" />
                    <Label text="PATIENTS" font="font:SmallSystemFont" color="0x1E3A34FF" translation="[24, 86]" />
                </Group>

                <!-- Stat 2: Today's Meds -->
                <Group translation="[393, 0]">
                    <Rectangle width="382" height="112" color="0x0F0F17FF" translation="[-1, -1]" />
                    <Rectangle width="380" height="110" color="0x0C0C13FF" />
                    <Label id="statMeds" text="2" font="font:LargeBoldSystemFont" color="0xF59E0BFF" translation="[24, 18]" />
                    <Rectangle width="32" height="3" color="0xF59E0BFF" translation="[24, 76]" />
                    <Label text="TODAY'S MEDS" font="font:SmallSystemFont" color="0x3D2E09FF" translation="[24, 86]" />
                </Group>

                <!-- Stat 3: Appointments -->
                <Group translation="[786, 0]">
                    <Rectangle width="382" height="112" color="0x0F0F17FF" translation="[-1, -1]" />
                    <Rectangle width="380" height="110" color="0x0C0C13FF" />
                    <Label id="statAppts" text="1" font="font:LargeBoldSystemFont" color="0x8B5CF6FF" translation="[24, 18]" />
                    <Rectangle width="32" height="3" color="0x8B5CF6FF" translation="[24, 76]" />
                    <Label text="APPOINTMENTS" font="font:SmallSystemFont" color="0x2D1B69FF" translation="[24, 86]" />
                </Group>

                <!-- Stat 4: Pending Tasks -->
                <Group translation="[1179, 0]">
                    <Rectangle width="382" height="112" color="0x0F0F17FF" translation="[-1, -1]" />
                    <Rectangle width="380" height="110" color="0x0C0C13FF" />
                    <Label id="statTasks" text="0" font="font:LargeBoldSystemFont" color="0xEF4444FF" translation="[24, 18]" />
                    <Rectangle width="32" height="3" color="0xEF4444FF" translation="[24, 76]" />
                    <Label text="PENDING TASKS" font="font:SmallSystemFont" color="0x3D0F0FFF" translation="[24, 86]" />
                </Group>
            </Group>

            <!-- LOWER CONTENT -->
            <!-- Left Column: x:40 y:362 -->
            <Group translation="[40, 362]">
                <Label text="VERSE OF THE DAY" font="font:SmallSystemFont" color="0x1E293BFF" translation="[0, 0]" />
                
                <!-- Verse Card -->
                <Group translation="[0, 24]">
                    <Rectangle width="434" height="392" color="0x0F0F17FF" translation="[-1, -1]" />
                    <Rectangle width="432" height="390" color="0x0C0C13FF" />
                    <Label id="verseText" text="For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life." font="font:MediumSystemFont" color="0x94A3B8FF" translation="[12, 20]" width="408" wrap="true" />
                    <Label id="verseRef" text="— John 3:16" font="font:MediumSystemFont" color="0x00C9A7FF" translation="[12, 354]" />
                </Group>

                <!-- Drawing Card -->
                <Label text="DRAWING OF THE DAY" font="font:SmallSystemFont" color="0x1E293BFF" translation="[0, 444]" />
                <Group translation="[0, 468]">
                    <Rectangle width="434" height="252" color="0x0F0F17FF" translation="[-1, -1]" />
                    <Rectangle width="432" height="250" color="0x0C0C13FF" />
                    <Label text="Take a moment to appreciate the beauty around you." font="font:MediumSystemFont" color="0x475569FF" translation="[12, 20]" width="300" wrap="true" />
                    <Rectangle width="56" height="56" color="0x111120FF" translation="[12, 106]" />
                    <Label text="Scan to view" font="font:MediumSystemFont" color="0x1E293BFF" translation="[78, 124]" />
                </Group>
            </Group>

            <!-- Right Column: x:492 y:362 -->
            <Group translation="[452, 362]">
                <Label text="QUICK ACTIONS" font="font:SmallSystemFont" color="0x1E293BFF" translation="[0, 0]" />
                
                <MarkupGrid id="quickActionsGrid"
                    translation="[0, 24]"
                    itemComponentName="QuickActionCard"
                    itemSize="[285, 315]"
                    itemSpacing="[16, 16]"
                    numColumns="4"
                    numRows="2"
                    drawFocusFeedback="false" />
            </Group>

        </Group>

        <Timer id="clockTimer" duration="30" repeat="true" />
        <Timer id="idleTimer" duration="300" repeat="false" />
        
        <Group id="loadingOverlay" visible="true">
            <Rectangle width="1920" height="1080" color="0x08080EFF" />
            <LoadingSpinner id="spinner" translation="[930, 450]" />
            <Label text="Loading your dashboard..." font="font:MediumSystemFont" color="0x6B7280FF" horizAlign="center" width="1920" translation="[0, 530]" />
        </Group>
    </children>
</component>
