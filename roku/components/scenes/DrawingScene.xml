<?xml version="1.0" encoding="utf-8" ?>
<component name="DrawingScene" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/DrawingScene.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0xF2F4F7FF" />
        <Rectangle width="1920" height="90" color="0xFFFFFFFF" />
        <Rectangle width="1920" height="3" color="0x00A89DFF" translation="[0, 87]" />
        <Label text="FamilyCare TV" font="font:LargeBoldSystemFont" color="0x00A89DFF" translation="[60, 20]" />
        <Label text="Drawing of the Day" font="font:MediumBoldSystemFont" color="0x1A1A2EFF" translation="[340, 30]" />
        <!-- Large centered drawing display -->
        <Rectangle width="1200" height="700" color="0xFFFFFFFF" translation="[360, 130]" />
        <Rectangle width="1200" height="4" color="0xFF6B6BFF" translation="[360, 130]" />
        <Poster id="drawingFullImage" width="800" height="500"
            translation="[560, 170]" loadDisplayMode="scaleToFit" />
        <Label id="drawingTitle" text="Drawing of the Day"
            font="font:MediumBoldSystemFont" color="0xFF6B6BFF"
            translation="[560, 690]" />
        <Label id="drawingDesc" text="Explore creativity with today's featured drawing."
            font="font:MediumSystemFont" color="0x4A4A68FF"
            translation="[560, 730]" width="800" wrap="true" />
        <!-- QR Code (bottom-right) -->
        <Group translation="[1400, 690]">
            <Rectangle width="120" height="120" color="0xF0F0F0FF" />
            <Poster id="drawingQR" width="110" height="110" translation="[5, 5]"
                loadDisplayMode="scaleToFit" uri="pkg:/images/fallback_qr.png" />
            <Label text="Scan to buy" font="font:SmallSystemFont" color="0x8E8EA0FF"
                translation="[0, 125]" width="120" horizAlign="center" />
        </Group>
        <Label text="Press BACK to return home." font="font:SmallSystemFont"
            color="0xB0B0BEFF" translation="[560, 800]" />
    </children>
</component>
