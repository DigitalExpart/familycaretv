<?xml version="1.0" encoding="utf-8" ?>
<component name="QuickActionTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="OnItemContentChange" />
        <field id="itemHasFocus" type="boolean" value="false" onChange="OnItemFocusChange" />
        <field id="width" type="float" value="415" />
        <field id="height" type="float" value="180" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/common/QuickActionTile.brs" />
    <children>
        <Group id="scaleContainer" scaleRotateCenter="[207.5, 90]">
            <!-- Focus glow (behind card) -->
            <Rectangle id="focusGlow" width="419" height="184" color="0x00C9A750"
                translation="[-2, -2]" visible="false" cornerRoundingRadius="10" />

            <!-- Card border -->
            <Rectangle id="cardBorder" width="415" height="180" color="0xE2E8F0FF"
                cornerRoundingRadius="10" />

            <!-- Card background -->
            <Rectangle id="cardBg" width="411" height="176" color="0xFFFFFFFF"
                translation="[2, 2]" cornerRoundingRadius="10" />

            <!-- Left accent bar -->
            <Rectangle id="accentBar" width="5" height="176" color="0x00C9A7FF"
                translation="[2, 2]" />

            <!-- Bounded Dynamic Vertical Flow (No horizAlignment=center on LayoutGroup) -->
            <LayoutGroup id="contentStack" layoutDirection="vert"
                translation="[24, 18]" itemSpacings="[8, 6]">

                <!-- Icon: Centered in 367px bounded width: (367 - 40) / 2 = 163 -->
                <Poster id="icon" width="40" height="40" translation="[163, 0]"
                    loadDisplayMode="scaleToFit" />

                <!-- Title (Centered via Label horizAlign inside 367px bounded width) -->
                <Label id="titleLabel"
                    font="font:MediumBoldSystemFont"
                    color="0x0F172AFF"
                    horizAlign="center"
                    width="367"
                    wrap="true"
                    maxLines="2" />

                <!-- Subtitle (Centered via Label horizAlign inside 367px bounded width) -->
                <Label id="descLabel"
                    font="font:SmallSystemFont"
                    color="0x64748BFF"
                    horizAlign="center"
                    width="367"
                    wrap="true"
                    maxLines="2" />
            </LayoutGroup>
        </Group>

        <!-- Focus scale animation -->
        <Animation id="focusInAnim" duration="0.15" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator
                key="[0.0, 1.0]"
                keyValue="[ [1.0, 1.0], [1.03, 1.03] ]"
                fieldToInterp="scaleContainer.scale" />
        </Animation>

        <Animation id="focusOutAnim" duration="0.15" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator
                key="[0.0, 1.0]"
                keyValue="[ [1.03, 1.03], [1.0, 1.0] ]"
                fieldToInterp="scaleContainer.scale" />
        </Animation>
    </children>
</component>
