<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeSceneV2" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/HomeSceneV2.brs" />

    <children>
        <!-- Background -->
        <Rectangle width="1920" height="1080" color="0x070B14FF" />

        <!-- ========================================== -->
        <!-- SIDEBAR NAVIGATION RAIL                    -->
        <!-- ========================================== -->
        <Group id="sidebarGroup">
            <Rectangle width="220" height="1080" color="0x0D1220FF" />
            
            <!-- Logo area -->
            <Label text="FamilyCare" font="font:MediumBoldSystemFont" color="0x00C9A7FF" translation="[20, 40]" />
            <Label text="Health · Wellness" font="font:SmallSystemFont" color="0x6B7280FF" translation="[20, 75]" />

            <!-- Nav Items List -->
            <MarkupGrid id="sidebarNav"
                translation="[10, 140]"
                itemComponentName="SidebarNavItem"
                itemSize="[200, 60]"
                itemSpacing="[0, 10]"
                numColumns="1"
                numRows="9"
                drawFocusFeedback="false" />

            <!-- Notification Bell & Profile -->
            <Group translation="[20, 950]">
                <Rectangle width="180" height="2" color="0x1E2D40FF" translation="[0, 0]" />
                
                <!-- Notification Bell -->
                <Group id="navBell" translation="[20, 20]">
                    <Poster width="32" height="32" uri="pkg:/images/icon_notifications.png" blendColor="0x6B7280FF" />
                    <Rectangle id="navBadge" width="12" height="12" color="0xEF4444FF" translation="[20, 0]" visible="false" />
                </Group>

                <!-- User Profile -->
                <Group translation="[20, 70]">
                    <Rectangle width="36" height="36" color="0x1E2D40FF" />
                    <Label text="FC" font="font:SmallBoldSystemFont" color="0x00C9A7FF" translation="[8, 6]" />
                    <Label text="Family Profile" font="font:SmallSystemFont" color="0xF9FAFBFF" translation="[50, 6]" />
                </Group>
            </Group>
        </Group>

        <!-- ========================================== -->
        <!-- MAIN CONTENT AREA                          -->
        <!-- ========================================== -->
        <Group id="mainContent" translation="[220, 0]">
            
            <!-- HEADER -->
            <Label id="greetingLabel" text="Good Morning, Family" font="font:LargeBoldSystemFont" color="0xF9FAFBFF" translation="[60, 60]" />
            <Label id="dateLabel" text="Loading Date..." font="font:MediumSystemFont" color="0x6B7280FF" translation="[60, 110]" />

            <!-- NOTIFICATION BANNER (Hidden by default) -->
            <Group id="notificationBanner" translation="[60, 150]" visible="false">
                <Rectangle width="1580" height="40" color="0xF59E0B20" />
                <Rectangle width="4" height="40" color="0xF59E0BFF" />
                <Label id="notificationText" text="You have 2 upcoming appointments today" font="font:SmallBoldSystemFont" color="0xF59E0BFF" translation="[20, 8]" />
            </Group>

            <!-- STATS STRIP -->
            <!-- 4 Cards, available width = 1580. Card width = 380, spacing = 20 (380*4 + 60 = 1580) -->
            <Group id="statsStrip" translation="[60, 200]">
                
                <!-- Stat 1: Patients -->
                <Group translation="[0, 0]">
                    <Rectangle width="380" height="120" color="0x111827FF" />
                    <Rectangle width="380" height="4" color="0x00C9A780" translation="[0, 116]" />
                    <Poster width="24" height="24" uri="pkg:/images/icon_patients.png" blendColor="0x00C9A7FF" translation="[20, 20]" />
                    <Label id="statPatients" text="0" font="font:LargeBoldSystemFont" color="0x00C9A7FF" translation="[20, 50]" />
                    <Label text="Patients" font="font:MediumSystemFont" color="0x6B7280FF" translation="[80, 70]" />
                </Group>

                <!-- Stat 2: Today's Meds -->
                <Group translation="[400, 0]">
                    <Rectangle width="380" height="120" color="0x111827FF" />
                    <Rectangle width="380" height="4" color="0xF59E0B80" translation="[0, 116]" />
                    <Poster width="24" height="24" uri="pkg:/images/icon_medications.png" blendColor="0xF59E0BFF" translation="[20, 20]" />
                    <Label id="statMeds" text="0" font="font:LargeBoldSystemFont" color="0xF59E0BFF" translation="[20, 50]" />
                    <Label text="Today's Meds" font="font:MediumSystemFont" color="0x6B7280FF" translation="[80, 70]" />
                </Group>

                <!-- Stat 3: Appointments -->
                <Group translation="[800, 0]">
                    <Rectangle width="380" height="120" color="0x111827FF" />
                    <Rectangle width="380" height="4" color="0x8B5CF680" translation="[0, 116]" />
                    <Poster width="24" height="24" uri="pkg:/images/icon_calendar.png" blendColor="0x8B5CF6FF" translation="[20, 20]" />
                    <Label id="statAppts" text="0" font="font:LargeBoldSystemFont" color="0x8B5CF6FF" translation="[20, 50]" />
                    <Label text="Appointments" font="font:MediumSystemFont" color="0x6B7280FF" translation="[80, 70]" />
                </Group>

                <!-- Stat 4: Tasks -->
                <Group translation="[1200, 0]">
                    <Rectangle width="380" height="120" color="0x111827FF" />
                    <Rectangle width="380" height="4" color="0xEF444480" translation="[0, 116]" />
                    <Poster width="24" height="24" uri="pkg:/images/icon_notes.png" blendColor="0xEF4444FF" translation="[20, 20]" />
                    <Label id="statTasks" text="0" font="font:LargeBoldSystemFont" color="0xEF4444FF" translation="[20, 50]" />
                    <Label text="Pending Tasks" font="font:MediumSystemFont" color="0x6B7280FF" translation="[80, 70]" />
                </Group>
            </Group>

            <!-- MAIN CONTENT GRID -->
            <!-- Left: Today's Overview (Width 480) -->
            <!-- Right: Quick Actions (Width 1060, 4 cols) -->
            <Group translation="[60, 360]">
                
                <!-- Left Section: Today's Overview -->
                <Group id="overviewGroup" translation="[0, 0]">
                    <Label text="Today's Overview" font="font:MediumBoldSystemFont" color="0xF9FAFBFF" translation="[0, 0]" />
                    
                    <!-- Verse Card -->
                    <Group translation="[0, 40]">
                        <Rectangle width="480" height="240" color="0x111827FF" />
                        <Rectangle width="480" height="3" color="0x00C9A7FF" />
                        <Label text="Verse of the Day" font="font:SmallBoldSystemFont" color="0x00C9A7FF" translation="[20, 20]" />
                        <Label id="verseText" font="font:MediumSystemFont" color="0xF9FAFBFF" translation="[20, 60]" width="440" wrap="true" maxLines="4" />
                        <Label id="verseRef" font="font:SmallSystemFont" color="0x6B7280FF" translation="[20, 190]" />
                    </Group>

                    <!-- Next Appointment -->
                    <Group translation="[0, 300]">
                        <Rectangle width="480" height="140" color="0x111827FF" />
                        <Rectangle width="480" height="3" color="0x8B5CF6FF" />
                        <Label text="Next Appointment" font="font:SmallBoldSystemFont" color="0x8B5CF6FF" translation="[20, 20]" />
                        <Label id="apptName" text="Dr. Smith - General Checkup" font="font:MediumBoldSystemFont" color="0xF9FAFBFF" translation="[20, 55]" />
                        <Label id="apptTime" text="In 3 hours" font="font:MediumSystemFont" color="0x8B5CF6FF" translation="[20, 95]" />
                    </Group>

                    <!-- Meds Due -->
                    <Group translation="[0, 460]">
                        <Rectangle width="480" height="140" color="0x111827FF" />
                        <Rectangle width="480" height="3" color="0xF59E0BFF" />
                        <Label text="Medication Due" font="font:SmallBoldSystemFont" color="0xF59E0BFF" translation="[20, 20]" />
                        <Label id="medName" text="Lisinopril 10mg" font="font:MediumBoldSystemFont" color="0xF9FAFBFF" translation="[20, 55]" />
                        <Label id="medTime" text="Due at 8:00 PM" font="font:MediumSystemFont" color="0xF59E0BFF" translation="[20, 95]" />
                    </Group>
                </Group>

                <!-- Right Section: Quick Actions -->
                <Group id="actionsGroup" translation="[520, 0]">
                    <Label text="Quick Actions" font="font:MediumBoldSystemFont" color="0xF9FAFBFF" translation="[0, 0]" />
                    
                    <MarkupGrid id="quickActionsGrid"
                        translation="[0, 40]"
                        itemComponentName="QuickActionCard"
                        itemSize="[260, 280]"
                        itemSpacing="[20, 20]"
                        numColumns="4"
                        numRows="2"
                        drawFocusFeedback="false" />
                </Group>
            </Group>

        </Group>

        <!-- Notification slide-in overlay -->
        <Group id="notificationOverlay" translation="[1400, -100]" visible="false">
            <Rectangle width="460" height="100" color="0x111827F0" />
            <Rectangle width="6" height="100" color="0xEF4444FF" />
            <Label id="overlayTitle" font="font:SmallBoldSystemFont" color="0xF9FAFBFF" translation="[20, 15]" />
            <Label id="overlayMsg" font="font:SmallSystemFont" color="0x6B7280FF" translation="[20, 50]" width="420" wrap="true" />
            <Animation id="slideInAnim" duration="0.4" easeFunction="outQuad">
                <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[ [1400, -100], [1400, 40] ]" fieldToInterp="notificationOverlay.translation" />
            </Animation>
            <Animation id="slideOutAnim" duration="0.4" easeFunction="inQuad">
                <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[ [1400, 40], [1400, -100] ]" fieldToInterp="notificationOverlay.translation" />
            </Animation>
            <Timer id="notificationTimer" duration="5" repeat="false" />
        </Group>

        <!-- Services -->
        <ApiTask id="dashboardTask" />
        <Timer id="clockTimer" duration="30" repeat="true" />
        <Timer id="idleTimer" duration="300" repeat="false" /> <!-- 5 minutes = 300s -->
        <Task id="notificationTask" type="NotificationTask" />

        <Group id="loadingOverlay" visible="true">
            <Rectangle width="1920" height="1080" color="0x070B14FF" />
            <LoadingSpinner id="spinner" translation="[930, 450]" />
            <Label text="Loading your dashboard..." font="font:MediumSystemFont" color="0x6B7280FF" horizAlign="center" width="1920" translation="[0, 530]" />
        </Group>
    </children>
</component>
