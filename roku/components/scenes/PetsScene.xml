<?xml version="1.0" encoding="utf-8" ?>
<component name="PetsScene" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/PetsScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x121212FF" />

        <!-- Header -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0x1E1E1EFF" />
            <Rectangle width="1920" height="3" color="0x66BB6AFF" translation="[0, 87]" />
            <Group id="backBtn" translation="[60, 20]">
                <Rectangle id="backFocusBorder" width="224" height="54" color="0x607D8BFF" translation="[-2, -2]" visible="false" />
                <Rectangle id="backBg" width="220" height="50" color="0x444444FF" />
                <Label text="← Back" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="220" translation="[0, 12]" />
            </Group>
            
            <Label text="Pet Care &amp; Vet Records" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[340, 30]" />

            <!-- [+] Add Pet Button -->
            <Group id="addBtnGroup" translation="[1600, 18]">
                <Rectangle id="addBtnFocusBorder" width="264" height="54" color="0x66BB6AFF" translation="[-2, -2]" visible="false" />
                <Rectangle id="addBtnBg" width="260" height="50" color="0x66BB6AFF" />
                <Label text="✚ Add Pet" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="260" translation="[0, 12]" />
            </Group>
        </Group>

        <!-- Pets Grid -->
        <MarkupGrid id="petsGrid"
            translation="[80, 140]"
            itemComponentName="QuickActionTile"
            itemSize="[415, 175]"
            itemSpacing="[20, 20]"
            numColumns="4"
            numRows="5"
            drawFocusFeedback="false"
            visible="false" />

        <!-- Empty State -->
        <Group id="emptyState" visible="false" translation="[560, 360]">
            <Rectangle width="800" height="260" color="0x1E1E1EFF" />
            <Rectangle width="800" height="4" color="0x66BB6AFF" />
            <Label text="No Pet Profiles Found" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" translation="[40, 40]" />
            <Label text="Keep track of pet feeding schedules, vet contacts, and care instructions." font="font:MediumSystemFont" color="0xAAAAAAFF" translation="[40, 95]" />
            <Label text="Click [+ Add Pet] to create your family pet profile." font="font:SmallSystemFont" color="0x8E8EA0FF" translation="[40, 150]" />
        </Group>

        <!-- Footer -->
        <Rectangle width="1920" height="36" color="0xE8EBF0FF" translation="[0, 1044]" />
        <Label text="Back Return  |  OK Edit Pet Profile  |  * Options Delete  |  ▲ Up to Add Button"
            font="font:SmallSystemFont" color="0x8E8EA0FF" translation="[80, 1050]" />

        <!-- Services -->
        <ApiTask id="petsTask" />
        <ApiTask id="deleteTask" />
        <ErrorDialog id="errorDialog" />

        <ConfirmDialog id="confirmDeleteDialog" title="Delete Pet Profile" message="Are you sure you want to delete this pet profile?" confirmText="Yes, Delete" cancelText="Cancel" />

        <Group id="loadingOverlay" visible="true">
            <LoadingSpinner translation="[930, 480]" />
            <Label text="Loading pet profiles..." font="font:MediumSystemFont" color="0xAAAAAAFF" horizAlign="center" width="1920" translation="[0, 560]" />
        </Group>
    </children>
</component>
