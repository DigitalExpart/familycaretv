<?xml version="1.0" encoding="utf-8" ?>
<component name="KidsScene" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/KidsScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x121212FF" />

        <!-- Header -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0x1E1E1EFF" />
            <Rectangle width="1920" height="3" color="0x7E57C2FF" translation="[0, 87]" />
            <Group id="backBtn" translation="[60, 20]">
                <Rectangle id="backFocusBorder" width="224" height="54" color="0x607D8BFF" translation="[-2, -2]" visible="false" />
                <Rectangle id="backBg" width="220" height="50" color="0x444444FF" />
                <Label text="← Back" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="220" translation="[0, 12]" />
            </Group>
            <Label text="Kids Activities &amp; Coloring Gallery" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[340, 30]" />
        </Group>

        <!-- Gallery Grid -->
        <MarkupGrid id="kidsGrid"
            translation="[80, 140]"
            itemComponentName="QuickActionTile"
            itemSize="[415, 175]"
            itemSpacing="[20, 20]"
            numColumns="4"
            numRows="5"
            drawFocusFeedback="false" />

        <!-- Fullscreen Artwork Preview Overlay -->
        <Group id="previewOverlay" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000CC" />

            <Group translation="[260, 100]">
                <Rectangle width="1400" height="880" color="0x1E1E1EFF" />
                <Poster id="previewImage" width="900" height="600" translation="[250, 40]" loadDisplayMode="scaleToFit" />

                <Label id="previewTitle" text="Activity Title" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" translation="[60, 660]" />
                <Label id="previewDesc" text="Activity description and instructions." font="font:MediumSystemFont" color="0xAAAAAAFF" translation="[60, 710]" width="1000" wrap="true" />

                <!-- QR Overlay -->
                <Group translation="[1160, 680]">
                    <Rectangle width="200" height="160" color="0x2A2A2AFF" />
                    <Poster width="110" height="110" translation="[45, 10]" loadDisplayMode="scaleToFit" uri="pkg:/images/fallback_qr.png" />
                    <Label text="Scan to Print" font="font:SmallBoldSystemFont" color="0x7E57C2FF" translation="[0, 125]" width="200" horizAlign="center" />
                </Group>

                <Label text="Press BACK or OK to close preview" font="font:SmallSystemFont" color="0x8E8EA0FF" translation="[60, 820]" />
            </Group>
        </Group>

        <!-- Footer -->
        <Rectangle width="1920" height="36" color="0xE8EBF0FF" translation="[0, 1044]" />
        <Label text="Back Return to Dashboard  |  OK View Full Screen Activity Card"
            font="font:SmallSystemFont" color="0x8E8EA0FF" translation="[80, 1050]" />

        <!-- Services -->
        <ApiTask id="kidsTask" />
        <ErrorDialog id="errorDialog" />

        <Group id="loadingOverlay" visible="true">
            <LoadingSpinner translation="[930, 480]" />
        </Group>
    </children>
</component>
