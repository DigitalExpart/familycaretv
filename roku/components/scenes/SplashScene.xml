    <script type="text/brightscript" uri="pkg:/components/scenes/SplashScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/RegistryService.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />

    <children>
        <!-- Background -->
        <Rectangle width="1920" height="1080" color="0xF0F2F5FF" />
        
        <!-- Outer decorative ring -->
        <Rectangle width="190" height="190" color="0xCCFBF1FF" cornerRoundingRadius="95" translation="[865, 350]" />
        <Rectangle width="186" height="186" color="0xF0F2F5FF" cornerRoundingRadius="93" translation="[867, 352]" />
        
