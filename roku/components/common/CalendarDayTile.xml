<?xml version="1.0" encoding="utf-8" ?>
<component name="CalendarDayTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="OnItemContentChange" />
        <field id="focusPercent" type="float" onChange="OnFocusChange" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/common/CalendarDayTile.brs" />

    <children>
        <Rectangle id="focusGlow" width="226" height="90" color="0x42A5F5FF" translation="[-3, -3]" visible="false" cornerRoundingRadius="6" />
        <Rectangle id="cardBorder" width="222" height="86" color="0xE2E8F0FF" translation="[-1, -1]" cornerRoundingRadius="6" />
        <Rectangle id="cardBg" width="220" height="84" color="0xFFFFFFFF" cornerRoundingRadius="6" />

        <Label id="dayLabel" font="font:MediumBoldSystemFont" color="0x0F172AFF" translation="[14, 8]" />

        <Group id="eventsGroup" translation="[14, 48]" visible="false">
            <Rectangle width="8" height="8" color="0x00A884FF" translation="[0, 5]" cornerRoundingRadius="4" />
            <Label id="eventsLabel" font="font:SmallestSystemFont" color="0x334155FF" translation="[14, 0]" width="186" maxLines="1" ellipsizeOnBoundary="true" />
        </Group>
    </children>
</component>
