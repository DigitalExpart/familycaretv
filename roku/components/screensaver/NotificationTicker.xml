<?xml version="1.0" encoding="utf-8" ?>
<component name="NotificationTicker" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/screensaver/NotificationTicker.brs" />
    <interface>
        <function name="setNotifications" />
        <function name="setMessages" />
    </interface>
    <children>
        <Rectangle width="1920" height="80" color="0xFFFFFFFF" />
        <Rectangle width="1920" height="1" color="0xE2E8F0FF" translation="[0, 0]" />
        <Label id="tickerText" translation="[1920, 24]" font="font:MediumBoldSystemFont" color="0x0F172AFF" />
        
        <Animation id="scrollAnim" duration="20" easeFunction="linear" repeat="true">
            <Vector2DFieldInterpolator id="scrollInterp" key="[0, 1]" keyValue="[[1920, 24], [-2000, 24]]" fieldToInterp="tickerText.translation" />
        </Animation>
    </children>
</component>
