<?xml version="1.0" encoding="utf-8" ?>
<component name="BibleVerseScene" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/BibleVerseScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0xF0F2F5FF" />

        <!-- Header -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0xFFFFFFFF" />
            <Rectangle width="1920" height="1" color="0xE2E8F0FF" translation="[0, 89]" />
            <Rectangle width="1920" height="3" color="0x00C9A7FF" translation="[0, 87]" />
            
            <Label text="FamilyCare TV" font="font:MediumBoldSystemFont" color="0x00C9A7FF" translation="[80, 28]" />
            <Label text="Verse of the Day" font="font:MediumBoldSystemFont" color="0x0F172AFF" translation="[340, 28]" width="1200" />

            <!-- Language Toggle Button (EN / ES) -->
            <Group id="langToggleBtn" translation="[1680, 18]">
                <Rectangle id="langFocusBorder" width="164" height="54" color="0x00C9A7FF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                <Rectangle id="langBorder" width="162" height="52" color="0xE2E8F0FF" translation="[-1, -1]" cornerRoundingRadius="8" />
                <Rectangle id="langBg" width="160" height="50" color="0xE6F7F4FF" cornerRoundingRadius="8" />
                <Label id="langToggleText" text="EN / ES" font="font:MediumBoldSystemFont" color="0x00C9A7FF" horizAlign="center" width="160" translation="[0, 12]" />
            </Group>
        </Group>

        <!-- Main Card Container -->
        <Group translation="[360, 120]">
            <Rectangle width="1204" height="864" color="0xE2E8F0FF" translation="[-2, -2]" cornerRoundingRadius="12" />
            <Rectangle width="1200" height="860" color="0xFFFFFFFF" cornerRoundingRadius="12" />
            <Rectangle width="1200" height="4" color="0x00C9A7FF" />

            <Label text="Daily Scripture &amp; Reflection" font="font:MediumBoldSystemFont" color="0x00C9A7FF" translation="[60, 35]" width="1080" />

            <!-- Verse Box -->
            <Rectangle width="1082" height="302" color="0xE2E8F0FF" translation="[59, 79]" cornerRoundingRadius="8" />
            <Rectangle width="1080" height="300" color="0xF8FAFCFF" translation="[60, 80]" cornerRoundingRadius="8" />
            <Rectangle width="5" height="300" color="0x00C9A7FF" translation="[60, 80]" />

            <!-- Dynamic Verse Text Stack -->
            <LayoutGroup layoutDirection="vert" translation="[90, 95]" itemSpacings="[12]">
                <Label id="verseText"
                    font="font:LargeSystemFont" color="0x0F172AFF"
                    width="1020" wrap="true" maxLines="5"
                    text="&quot;For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life.&quot;" />

                <Label id="verseRef" text="— John 3:16"
                    font="font:MediumBoldSystemFont" color="0x00C9A7FF"
                    width="1020" />
            </LayoutGroup>

            <!-- Daily Reflection Section -->
            <Group translation="[60, 410]">
                <Label text="Thought for Today" font="font:MediumBoldSystemFont" color="0x0F172AFF" translation="[0, 0]" width="1080" />
                <Rectangle width="1082" height="382" color="0xE2E8F0FF" translation="[-1, 34]" cornerRoundingRadius="8" />
                <Rectangle width="1080" height="380" color="0xF8FAFCFF" translation="[0, 35]" cornerRoundingRadius="8" />
                <Label id="reflectionText"
                    font="font:MediumSystemFont" color="0x64748BFF"
                    translation="[24, 55]" width="1032" wrap="true" maxLines="10"
                    text="May this verse bring peace, comfort, and strength to your family today. Take a moment to reflect on love, grace, and hope." />
            </Group>
        </Group>

        <!-- Safe-Area Footer Bar -->
        <Group id="footerGroup" translation="[0, 1008]">
            <Rectangle width="1920" height="52" color="0xFFFFFFFF" />
            <Rectangle width="1920" height="1" color="0xE2E8F0FF" translation="[0, 0]" />
            <Label text="Back Return to Dashboard  |  OK Toggle English / Spanish Language"
                font="font:SmallSystemFont" color="0x64748BFF" translation="[80, 14]" width="1760" />
        </Group>

        <!-- Services -->
        <ApiTask id="verseTask" />
        <ErrorDialog id="errorDialog" />

        <Group id="loadingOverlay" visible="true">
            <LoadingSpinner translation="[930, 480]" />
        </Group>
    </children>
</component>
