<?xml version="1.0" encoding="utf-8" ?>
<component name="CalendarScene" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/CalendarScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0xF0F2F5FF" />

        <!-- Header -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0xFFFFFFFF" />
            <Rectangle width="1920" height="1" color="0xE2E8F0FF" translation="[0, 89]" />
            <Rectangle width="1920" height="3" color="0x42A5F5FF" translation="[0, 87]" />
            
            <!-- [◄ Prev Month] Button -->
            <Group id="prevBtnGroup" translation="[80, 20]">
                <Rectangle id="prevBtnFocusBorder" width="144" height="54" color="0x42A5F5FF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                <Rectangle id="prevBtnBorder" width="142" height="52" color="0xE2E8F0FF" translation="[-1, -1]" cornerRoundingRadius="8" />
                <Rectangle id="prevBtnBg" width="140" height="50" color="0xF1F5F9FF" cornerRoundingRadius="8" />
                <Label text="◄ Prev" font="font:MediumBoldSystemFont" color="0x0F172AFF" horizAlign="center" width="140" translation="[0, 12]" />
            </Group>

            <!-- Month Label -->
            <Label id="monthLabel" text="August 2026 - Family Calendar" font="font:MediumBoldSystemFont" color="0x0F172AFF" horizAlign="center" width="700" translation="[250, 28]" />

            <!-- [Next Month ►] Button -->
            <Group id="nextBtnGroup" translation="[980, 20]">
                <Rectangle id="nextBtnFocusBorder" width="144" height="54" color="0x42A5F5FF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                <Rectangle id="nextBtnBorder" width="142" height="52" color="0xE2E8F0FF" translation="[-1, -1]" cornerRoundingRadius="8" />
                <Rectangle id="nextBtnBg" width="140" height="50" color="0xF1F5F9FF" cornerRoundingRadius="8" />
                <Label text="Next ►" font="font:MediumBoldSystemFont" color="0x0F172AFF" horizAlign="center" width="140" translation="[0, 12]" />
            </Group>

            <!-- [+] Add Event Button -->
            <Group id="addBtnGroup" translation="[1580, 18]">
                <Rectangle id="addBtnFocusBorder" width="284" height="54" color="0x42A5F5FF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                <Rectangle id="addBtnBg" width="280" height="50" color="0x42A5F5FF" cornerRoundingRadius="8" />
                <Label text="✚ Add Event" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="280" translation="[0, 12]" />
            </Group>
        </Group>

        <!-- Days of Week Header -->
        <LayoutGroup translation="[160, 108]" layoutDirection="horiz" itemSpacings="[10,10,10,10,10,10,10]">
            <Label text="Sunday" width="220" horizAlign="center" font="font:SmallBoldSystemFont" color="0x64748BFF" />
            <Label text="Monday" width="220" horizAlign="center" font="font:SmallBoldSystemFont" color="0x64748BFF" />
            <Label text="Tuesday" width="220" horizAlign="center" font="font:SmallBoldSystemFont" color="0x64748BFF" />
            <Label text="Wednesday" width="220" horizAlign="center" font="font:SmallBoldSystemFont" color="0x64748BFF" />
            <Label text="Thursday" width="220" horizAlign="center" font="font:SmallBoldSystemFont" color="0x64748BFF" />
            <Label text="Friday" width="220" horizAlign="center" font="font:SmallBoldSystemFont" color="0x64748BFF" />
            <Label text="Saturday" width="220" horizAlign="center" font="font:SmallBoldSystemFont" color="0x64748BFF" />
        </LayoutGroup>

        <!-- Calendar Grid -->
        <MarkupGrid id="eventsGrid"
            translation="[160, 145]"
            itemComponentName="CalendarDayTile"
            itemSize="[220, 136]"
            itemSpacing="[10, 10]"
            numColumns="7"
            numRows="6"
            drawFocusFeedback="false"
            visible="false" />

        <!-- Safe-Area Footer Bar -->
        <Group id="footerGroup" translation="[0, 1008]">
            <Rectangle width="1920" height="52" color="0xFFFFFFFF" />
            <Rectangle width="1920" height="1" color="0xE2E8F0FF" translation="[0, 0]" />
            <Label text="Back Return  |  OK View/Add Event  |  * Options Delete  |  ▲ Up to Add Button"
                font="font:SmallSystemFont" color="0x64748BFF" translation="[80, 14]" width="1760" />
        </Group>

        <!-- Services -->
        <ApiTask id="eventsTask" />
        <ApiTask id="deleteTask" />
        <ErrorDialog id="errorDialog" />

        <ConfirmDialog id="confirmDeleteDialog" title="Delete Event" message="Are you sure you want to delete this event?" confirmText="Yes, Delete" cancelText="Cancel" />

        <Group id="loadingOverlay" visible="true">
            <LoadingSpinner translation="[930, 480]" />
        </Group>
    </children>
</component>
