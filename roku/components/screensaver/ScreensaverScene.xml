<?xml version="1.0" encoding="utf-8" ?>
<component name="ScreensaverScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/screensaver/ScreensaverScene.brs" />

    <children>
        <!-- Pale neutral background -->
        <Rectangle width="1920" height="1080" color="0xF0F2F5FF" />
        
        <!-- Soft Mint Pulse Background -->
        <Rectangle id="pulseBg" width="1920" height="1080" color="0xE6F7F4FF" opacity="0.0" />
        <Animation id="pulseAnim" duration="8" repeat="true">
            <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.7, 0.0]" fieldToInterp="pulseBg.opacity" />
        </Animation>

        <!-- Center Logo -->
        <Group id="logoGroup" translation="[760, 440]">
            <Label text="FamilyCare TV" font="font:LargeBoldSystemFont" color="0x00C9A7FF" />
            <Label text="HEALTH · WELLNESS · FAMILY" font="font:MediumSystemFont" color="0x64748BFF" translation="[0, 50]" />
        </Group>

        <!-- Logo Fade Animation -->
        <Animation id="logoFadeAnim" duration="10" repeat="true">
            <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[0.4, 1.0, 0.4]" fieldToInterp="logoGroup.opacity" />
        </Animation>

        <!-- Rotating text at bottom -->
        <Label id="tipLabel" text="" font="font:MediumSystemFont" color="0x0F172AFF" translation="[0, 900]" width="1920" horizAlign="center" />
        
        <!-- Timer to rotate tips every 15 seconds -->
        <Timer id="tipTimer" duration="15" repeat="true" />

        <Animation id="tipFadeAnim" duration="1" repeat="false">
            <FloatFieldInterpolator id="tipFader" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="tipLabel.opacity" />
        </Animation>
    </children>
</component>
