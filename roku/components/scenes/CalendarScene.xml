<?xml version="1.0" encoding="utf-8" ?>
<component name="CalendarScene" extends="Group">
    <interface>
        <field id="navigate" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/CalendarScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x121212FF" />

        <!-- Header -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0x1E1E1EFF" />
            <Rectangle width="1920" height="3" color="0x42A5F5FF" translation="[0, 87]" />
            <Group id="backBtn" translation="[60, 20]">
                <Rectangle id="backFocusBorder" width="224" height="54" color="0x607D8BFF" translation="[-2, -2]" visible="false" />
                <Rectangle id="backBg" width="220" height="50" color="0x444444FF" />
                <Label text="← Back" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="220" translation="[0, 12]" />
            </Group>
            
            <Label text="Family Calendar &amp; Appointments" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[340, 30]" />

            <!-- [+] Add Event Button -->
            <Group id="addBtnGroup" translation="[1580, 18]">
                <Rectangle id="addBtnFocusBorder" width="284" height="54" color="0x42A5F5FF" translation="[-2, -2]" visible="false" />
                <Rectangle id="addBtnBg" width="280" height="50" color="0x42A5F5FF" />
                <Label text="✚ Add Event" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="280" translation="[0, 12]" />
            </Group>
        </Group>

        <!-- Events Grid -->
        <MarkupGrid id="eventsGrid"
            translation="[80, 140]"
            itemComponentName="QuickActionTile"
            itemSize="[415, 175]"
            itemSpacing="[20, 20]"
            numColumns="4"
            numRows="5"
            drawFocusFeedback="false"
            visible="false" />

        <!-- Empty State -->
        <Group id="emptyState" visible="false" translation="[560, 360]">
            <Rectangle width="800" height="260" color="0x1E1E1EFF" />
            <Rectangle width="800" height="4" color="0x42A5F5FF" />
            <Label text="No Upcoming Events" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" translation="[40, 40]" />
            <Label text="Keep track of doctor visits, family appointments, and care tasks." font="font:MediumSystemFont" color="0xAAAAAAFF" translation="[40, 95]" />
            <Label text="Click [+ Add Event] to schedule your first appointment." font="font:SmallSystemFont" color="0x8E8EA0FF" translation="[40, 150]" />
        </Group>

        <!-- Footer -->
        <Rectangle width="1920" height="36" color="0xE8EBF0FF" translation="[0, 1044]" />
        <Label text="Back Return  |  OK Edit Event  |  * Options Delete  |  ▲ Up to Add Button"
            font="font:SmallSystemFont" color="0x8E8EA0FF" translation="[80, 1050]" />

        <!-- Services -->
        <ApiTask id="eventsTask" />
        <ApiTask id="deleteTask" />
        <ErrorDialog id="errorDialog" />

        <ConfirmDialog id="confirmDeleteDialog" title="Delete Event" message="Are you sure you want to delete this event?" confirmText="Yes, Delete" cancelText="Cancel" />

        <Group id="loadingOverlay" visible="true">
            <LoadingSpinner translation="[930, 480]" />
            <Label text="Loading calendar events..." font="font:MediumSystemFont" color="0xAAAAAAFF" horizAlign="center" width="1920" translation="[0, 560]" />
        </Group>
    </children>
</component>
