<?xml version="1.0" encoding="utf-8" ?>
<component name="DeviceLinkScene" extends="Group">
    <interface>
        <field id="navigate" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/DeviceLinkScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/RegistryService.brs" />
    <children>
        <!-- ═══ PALE NEUTRAL BACKGROUND ═══ -->
        <Rectangle width="1920" height="1080" color="0xF0F2F5FF" />

        <!-- ═══ TOP BRANDING ═══ -->
        <Label text="FamilyCare TV"
            font="font:LargeBoldSystemFont" color="0x00C9A7FF"
            horizAlign="center" width="1920"
            translation="[0, 80]" />
        <Label text="HEALTH · WELLNESS · FAMILY"
            font="font:SmallSystemFont" color="0x94A3B8FF"
            horizAlign="center" width="1920"
            translation="[0, 130]" />

        <!-- ═══ CENTER CARD (White Card on Pale Bg) ═══ -->
        <Group translation="[460, 200]">
            <Rectangle width="1004" height="524" color="0xE2E8F0FF" translation="[-2, -2]" cornerRoundingRadius="14" />
            <Rectangle width="1000" height="520" color="0xFFFFFFFF" cornerRoundingRadius="14" />
            <Rectangle width="1000" height="4" color="0x00C9A7FF" />

            <!-- Instruction text -->
            <Label id="instructionLabel" 
                text="To link this TV to your FamilyCare account, enter the code below:" 
                font="font:MediumSystemFont" 
                color="0x0F172AFF" 
                horizAlign="center" 
                width="1000"
                wrap="true"
                maxLines="2"
                translation="[0, 40]" />

            <!-- Code display area -->
            <Group translation="[200, 110]">
                <!-- Code background -->
                <Rectangle width="604" height="124" color="0xE2E8F0FF" translation="[-2, -2]" cornerRoundingRadius="10" />
                <Rectangle width="600" height="120" color="0xF8FAFCFF" cornerRoundingRadius="10" />
                <Rectangle width="600" height="3" color="0x00C9A7FF" translation="[0, 0]" />
                <Rectangle width="600" height="3" color="0x00C9A7FF" translation="[0, 117]" />
                <!-- Code text -->
                <Label id="codeLabel" 
                    text="" 
                    font="font:LargeBoldSystemFont" 
                    color="0x00C9A7FF" 
                    horizAlign="center" 
                    vertAlign="center"
                    width="600"
                    height="120" />
            </Group>

            <!-- Expires text -->
            <Label id="expiresLabel" 
                text="" 
                font="font:SmallSystemFont" 
                color="0x64748BFF" 
                horizAlign="center" 
                width="1000"
                translation="[0, 260]" />

            <!-- Steps instructions in LayoutGroup -->
            <LayoutGroup layoutDirection="vert" translation="[0, 305]" itemSpacings="[10]">
                <Label text="Step 1: Open FamilyCare Mobile or Web App"
                    font="font:SmallSystemFont" color="0x334155FF"
                    horizAlign="center" width="1000" />
                <Label text="Step 2: Go to Profile → Connect Roku TV"
                    font="font:SmallSystemFont" color="0x334155FF"
                    horizAlign="center" width="1000" />
                <Label text="Step 3: Enter the 6-digit code shown above"
                    font="font:SmallSystemFont" color="0x334155FF"
                    horizAlign="center" width="1000" />
            </LayoutGroup>
        </Group>

        <!-- ═══ FOOTER ═══ -->
        <Label text="Waiting for device activation..."
            font="font:SmallSystemFont" color="0x94A3B8FF"
            horizAlign="center" width="1920"
            translation="[0, 780]" />

        <!-- ═══ API TASKS ═══ -->
        <ApiTask id="deviceCodeTask" />
        <ApiTask id="tokenPollTask" />
        <Timer id="pollTimer" repeat="true" duration="5.0" />
    </children>
</component>
