<?xml version="1.0" encoding="utf-8" ?>
<component name="ScreensaverScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/screensaver/ScreensaverScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <!-- Background -->
        <Rectangle id="bg" width="1920" height="1080" color="0xF2F4F7FF" />

        <!-- Header Bar -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0xFFFFFFFF" />
            <Rectangle width="1920" height="3" color="0x00A89DFF" translation="[0, 87]" />
            <Label text="FamilyCare TV" font="font:LargeBoldSystemFont" color="0x00A89DFF" translation="[60, 20]" />
            <Label text="Screensaver • Living Room Display" font="font:MediumSystemFont" color="0x8E8EA0FF" translation="[340, 30]" />

            <!-- Top Right Clock -->
            <Group id="dateTimeGroup" translation="[1380, 15]">
                <Label id="clockText" font="font:LargeBoldSystemFont" color="0x1A1A2EFF" horizAlign="right" width="480" />
                <Label id="dateText" font="font:SmallSystemFont" color="0x4A4A68FF" horizAlign="right" width="480" translation="[0, 42]" />
            </Group>
        </Group>

        <!-- Main Display Content Container -->
        <Group translation="[80, 130]">

            <!-- Left Panel: Drawing of the Day Artwork Card -->
            <Group id="drawingGroup" translation="[0, 0]">
                <Rectangle width="646" height="786" color="0x0000000A" translation="[3, 3]" />
                <Rectangle width="640" height="780" color="0xFFFFFFFF" />
                <Rectangle width="640" height="5" color="0xFF6B6BFF" />

                <Label text="Drawing of the Day" font="font:SmallBoldSystemFont" color="0xFF6B6BFF" translation="[30, 20]" />
                <Poster id="drawingPoster" width="580" height="420" translation="[30, 60]"
                    loadDisplayMode="scaleToFit" uri="pkg:/images/icon_kids.png" />

                <Label id="drawingThought"
                    font="font:SmallSystemFont" color="0x4A4A68FF"
                    translation="[30, 500]" width="580" wrap="true" maxLines="8"
                    text="&quot;Take a moment today to appreciate art and creativity.&quot;" />
            </Group>

            <!-- Right Panel: Scripture & QR Overlay -->
            <Group translation="[680, 0]">
                <!-- Verse Card -->
                <Rectangle width="1086" height="526" color="0x0000000A" translation="[3, 3]" />
                <Rectangle width="1080" height="520" color="0xFFFFFFFF" />
                <Rectangle width="1080" height="5" color="0x00A89DFF" />

                <Label text="Verse of the Day" font="font:SmallBoldSystemFont" color="0x00A89DFF" translation="[40, 25]" />

                <Label id="verseText"
                    font="font:LargeSystemFont" color="0x1A1A2EFF"
                    translation="[40, 75]" width="1000" wrap="true" maxLines="8"
                    text="&quot;For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life.&quot;" />

                <Label id="verseRef" text="- John 3:16"
                    font="font:MediumBoldSystemFont" color="0x00A89DFF"
                    translation="[40, 440]" />

                <!-- Bottom QR Code Card -->
                <Group translation="[0, 550]">
                    <Rectangle width="1086" height="236" color="0x0000000A" translation="[3, 3]" />
                    <Rectangle width="1080" height="230" color="0xFFFFFFFF" />
                    <Rectangle width="1080" height="5" color="0x7E57C2FF" />

                    <!-- QR Code -->
                    <Group translation="[40, 20]">
                        <Rectangle width="190" height="190" color="0xF5F7FAFF" />
                        <Poster id="qrCode" width="170" height="170" translation="[10, 10]"
                            loadDisplayMode="scaleToFit" uri="pkg:/images/fallback_qr.png" />
                    </Group>

                    <Label text="FamilyCare Mobile &amp; TV Sync" font="font:MediumBoldSystemFont" color="0x1A1A2EFF" translation="[260, 40]" />
                    <Label text="Scan QR code to access your family care dashboard on your mobile phone." font="font:SmallSystemFont" color="0x4A4A68FF" translation="[260, 85]" width="760" wrap="true" />
                    <Label text="Press any remote key to exit screensaver and return to app." font="font:SmallBoldSystemFont" color="0x00A89DFF" translation="[260, 150]" />
                </Group>
            </Group>
        </Group>

        <!-- Bottom Reminder Ticker Bar -->
        <NotificationTicker id="notificationTicker" translation="[0, 1000]" />

        <!-- Services -->
        <ApiTask id="screensaverTask" />
        <Timer id="clockTimer" duration="1" repeat="true" control="start" />
    </children>
</component>
