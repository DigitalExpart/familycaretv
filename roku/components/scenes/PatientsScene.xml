<?xml version="1.0" encoding="utf-8" ?>
<component name="PatientsScene" extends="Group">
    <interface>
        <field id="navigate" type="string" />
        <field id="patientData" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/PatientsScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <!-- Pale neutral page background -->
        <Rectangle width="1920" height="1080" color="0xF0F2F5FF" />

        <!-- Top Header Bar -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0xFFFFFFFF" />
            <Rectangle width="1920" height="1" color="0xE2E8F0FF" translation="[0, 89]" />
            <Rectangle width="1920" height="3" color="0x00C9A7FF" translation="[0, 87]" />
            
            <Label text="FamilyCare TV" font="font:MediumBoldSystemFont" color="0x00C9A7FF" translation="[80, 28]" />
            <Label text="Patients Directory" font="font:MediumBoldSystemFont" color="0x0F172AFF" translation="[340, 28]" width="1200" />

            <!-- [+] Add Patient Button (top right) -->
            <Group id="addBtnGroup" translation="[1580, 18]">
                <Rectangle id="addBtnFocusBorder" width="284" height="54" color="0x00C9A7FF" translation="[-2, -2]" visible="false" cornerRoundingRadius="8" />
                <Rectangle id="addBtnBg" width="280" height="50" color="0x00C9A7FF" cornerRoundingRadius="8" />
                <Label text="✚ Add Patient" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="280" translation="[0, 12]" />
            </Group>
        </Group>

        <!-- Patients Grid -->
        <MarkupGrid id="patientsGrid"
            translation="[80, 130]"
            itemComponentName="QuickActionTile"
            itemSize="[415, 175]"
            itemSpacing="[20, 20]"
            numColumns="4"
            numRows="4"
            drawFocusFeedback="false"
            visible="false" />

        <!-- Empty State Container (Fully Contained) -->
        <Group id="emptyState" visible="false" translation="[560, 340]">
            <Rectangle width="804" height="274" color="0xE2E8F0FF" translation="[-2, -2]" cornerRoundingRadius="12" />
            <Rectangle width="800" height="270" color="0xFFFFFFFF" cornerRoundingRadius="12" />
            <Rectangle width="800" height="4" color="0x00C9A7FF" />

            <LayoutGroup layoutDirection="vert" translation="[40, 36]" itemSpacings="[14, 12, 16]">
                <Label text="No Patients Found" font="font:MediumBoldSystemFont" color="0x0F172AFF" width="720" />
                <Label text="There are currently no patient profiles registered in your account." font="font:SmallSystemFont" color="0x64748BFF" width="720" wrap="true" maxLines="3" />
                <Label text="Click the [+ Add Patient] button above to create a new profile." font="font:SmallestSystemFont" color="0x94A3B8FF" width="720" wrap="true" maxLines="2" />
            </LayoutGroup>
        </Group>

        <!-- Safe-Area Footer -->
        <Group id="footerGroup" translation="[0, 1008]">
            <Rectangle width="1920" height="52" color="0xFFFFFFFF" />
            <Rectangle width="1920" height="1" color="0xE2E8F0FF" translation="[0, 0]" />
            <Label text="Back Return  |  OK View/Edit Patient  |  ▲ Up to Add Patient Button"
                font="font:SmallSystemFont" color="0x64748BFF" translation="[80, 14]" width="1760" />
        </Group>

        <!-- Services -->
        <ApiTask id="patientsTask" />
        <ErrorDialog id="errorDialog" />

        <!-- Loading Overlay -->
        <Group id="loadingOverlay" visible="true">
            <LoadingSpinner translation="[930, 480]" />
            <Label text="Loading patients..." font="font:MediumSystemFont" color="0x64748BFF" horizAlign="center" width="1920" translation="[0, 560]" />
        </Group>
    </children>
</component>
