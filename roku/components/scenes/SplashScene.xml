<?xml version="1.0" encoding="utf-8" ?>
<component name="SplashScene" extends="Group">
    <interface>
        <field id="navigate" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/SplashScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/RegistryService.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />

    <children>
        <!-- Clean light background -->
        <Rectangle width="1920" height="1080" color="0xF0F2F5FF" />

        <!-- Subtle soft radial glow behind logo (layered mint circles) -->
        <Rectangle width="640" height="640" color="0xD1FAF0FF" cornerRoundingRadius="320" translation="[640, 140]" opacity="0.6" />
        <Rectangle width="440" height="440" color="0xCCFBF1FF" cornerRoundingRadius="220" translation="[740, 240]" opacity="0.8" />

        <!-- Official Logo (centered, scales to fit) -->
        <Poster id="splashLogo"
            width="560"
            height="560"
            uri="pkg:/images/logo.png"
            loadDisplayMode="scaleToFit"
            translation="[680, 120]" />

        <!-- Thin teal accent line below logo -->
        <Rectangle width="120" height="3" color="0x00C9A7CC" cornerRoundingRadius="1" translation="[900, 700]" />

        <!-- Tagline -->
        <Label text="HEALTH · WELLNESS · FAMILY"
            font="font:MediumSystemFont"
            color="0x64748BFF"
            translation="[560, 724]"
            width="800"
            horizAlign="center" />

        <!-- Loading indicator -->
        <LoadingSpinner id="loadingSpinner" translation="[940, 810]" />

        <Timer id="timer" />
        <ApiTask id="validateTask" />
    </children>
</component>
