<?xml version="1.0" encoding="utf-8" ?>
<component name="PremiumCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="OnItemContentChange" />
        <field id="itemHasFocus" type="boolean" value="false" onChange="OnItemFocusChange" />
        <field id="width" type="float" value="300" />
        <field id="height" type="float" value="200" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/common/PremiumCard.brs" />
    
    <children>
        <Rectangle id="border" width="302" height="202" color="0xE2E8F0FF" translation="[-1, -1]" cornerRoundingRadius="10" />
        <Rectangle id="background" 
            width="300" height="200" 
            color="0xFFFFFFFF" 
            translation="[0, 0]" cornerRoundingRadius="10" />
            
        <Poster id="icon" 
            width="80" height="80" 
            translation="[110, 35]" 
            loadDisplayMode="scaleToFit" />
            
        <Label id="titleLabel" 
            font="font:SmallBoldSystemFont" 
            color="0x0F172AFF" 
            horizAlign="center" 
            translation="[0, 140]" 
            width="300" />
            
        <Animation id="focusAnimation" duration="0.2" repeat="false" easeFunction="linear">
            <Vector2DFieldInterpolator id="scaleInterp" 
                key="[0.0, 1.0]" 
                keyValue="[ [1.0, 1.0], [1.05, 1.05] ]" 
                fieldToInterp="background.scale" />
            <ColorFieldInterpolator id="colorInterp" 
                key="[0.0, 1.0]" 
                keyValue='[ "0xFFFFFFFF", "0xF0FDFBFF" ]' 
                fieldToInterp="background.color" />
        </Animation>
    </children>
</component>
