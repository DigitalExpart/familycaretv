<?xml version="1.0" encoding="utf-8" ?>
<component name="PetFormScene" extends="Group">
    <interface>
        <field id="petData" type="assocarray" onChange="OnPetDataChange" />
        <field id="closeRequest" type="boolean" value="false" alwaysNotify="true" />
        <field id="saved" type="boolean" value="false" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/scenes/PetFormScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x121212FF" />

        <!-- Header -->
        <Group id="headerGroup">
            <Rectangle width="1920" height="90" color="0x1E1E1EFF" />
            <Rectangle width="1920" height="3" color="0x66BB6AFF" translation="[0, 87]" />
            <Label text="FamilyCare TV" font="font:LargeBoldSystemFont" color="0x00A89DFF" translation="[60, 20]" />
            <Label id="formTitle" text="Add Pet Profile" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[340, 30]" />
        </Group>

        <!-- Form Card Container -->
        <Group translation="[460, 140]">
            <Rectangle width="1006" height="846" color="0x0000000A" translation="[3, 3]" />
            <Rectangle width="1000" height="840" color="0x1E1E1EFF" />
            <Rectangle width="1000" height="5" color="0x66BB6AFF" />

            <Label id="formSubtitle" text="Enter pet details and care instructions."
                font="font:MediumSystemFont" color="0xAAAAAAFF"
                translation="[50, 30]" />

            <!-- Input Fields -->
            <Group translation="[150, 90]">
                <FormInputField id="nameField" label="Pet Name *" placeholder="e.g. Max, Bella, Milo" translation="[0, 0]" />
                <FormInputField id="speciesField" label="Species *" placeholder="e.g. Dog, Cat, Bird" translation="[0, 110]" />
                <FormInputField id="breedField" label="Breed / Color" placeholder="e.g. Golden Retriever, Tabby" translation="[0, 220]" />
                <FormInputField id="notesField" label="Care Notes &amp; Vet Info" placeholder="e.g. Vet: Dr. Williams 555-0192, Eats twice daily" translation="[0, 330]" />
            </Group>

            <!-- Buttons Row -->
            <Group id="buttonsGroup" translation="[150, 680]">
                <Group id="saveBtnGroup" translation="[0, 0]">
                    <Rectangle id="saveFocusBorder" width="344" height="64" color="0x66BB6AFF" translation="[-2, -2]" visible="false" />
                    <Rectangle id="saveBg" width="340" height="60" color="0x66BB6AFF" />
                    <Label id="saveLabel" text="Save Pet"
                        font="font:MediumBoldSystemFont" color="0xFFFFFFFF"
                        horizAlign="center" width="340" translation="[0, 15]" />
                </Group>

                <Group id="cancelBtnGroup" translation="[360, 0]">
                    <Rectangle id="cancelFocusBorder" width="224" height="64" color="0x607D8BFF" translation="[-2, -2]" visible="false" />
                    <Rectangle id="cancelBg" width="220" height="60" color="0x444444FF" />
                    <Label id="cancelLabel" text="Cancel"
                        font="font:MediumBoldSystemFont" color="0xFFFFFFFF"
                        horizAlign="center" width="220" translation="[0, 15]" />
                </Group>
            </Group>
        </Group>

        <!-- Services -->
        <ApiTask id="saveTask" />
        <ErrorDialog id="errorDialog" />

        <KeyboardDialog id="keyboardDialog" visible="false" />

        <Group id="loadingOverlay" visible="false">
            <Rectangle width="1920" height="1080" color="0x00000044" />
            <LoadingSpinner translation="[930, 480]" />
            <Label text="Saving pet profile..." font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" width="1920" translation="[0, 560]" />
        </Group>
    </children>
</component>
