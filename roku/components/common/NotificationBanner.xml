<?xml version="1.0" encoding="utf-8" ?>
<component name="NotificationBanner" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/common/NotificationBanner.brs" />
    <interface>
        <field id="notification" type="assocarray" />
        <function name="showBanner" />
    </interface>
    
    <children>
        <Group id="backgroundRect" translation="[0, -150]">
            <Rectangle width="504" height="124" color="0xE2E8F0FF" translation="[-2, -2]" cornerRoundingRadius="10" />
            <Rectangle width="500" height="120" color="0xFFFFFFFF" cornerRoundingRadius="10" />
            <Rectangle id="priorityBar" width="6" height="120" translation="[0, 0]" color="0x00C9A7FF" />
            <LayoutGroup layoutDirection="vert" translation="[24, 18]" itemSpacings="[6]">
                <Label id="titleLabel" width="456" font="font:MediumBoldSystemFont" color="0x0F172AFF" wrap="true" maxLines="1" />
                <Label id="messageLabel" width="456" wrap="true" font="font:SmallSystemFont" color="0x64748BFF" maxLines="2" />
            </LayoutGroup>
        </Group>
        
        <Animation id="slideIn" duration="0.5" easeFunction="linear">
            <Vector2DFieldInterpolator id="slideInInterp" key="[0, 1]" keyValue="[[0, -150], [0, 20]]" fieldToInterp="backgroundRect.translation" />
        </Animation>
        
        <Animation id="slideOut" duration="0.5" easeFunction="linear">
            <Vector2DFieldInterpolator id="slideOutInterp" key="[0, 1]" keyValue="[[0, 20], [0, -150]]" fieldToInterp="backgroundRect.translation" />
        </Animation>
        
        <Timer id="dismissTimer" duration="5" repeat="false" />
    </children>
</component>
