<?xml version="1.0" encoding="utf-8" ?>
<component name="ScreensaverScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/screensaver/ScreensaverScene.brs" />

    <children>
        <!-- Deep dark background -->
        <Rectangle width="1920" height="1080" color="0x070B14FF" />
        
        <!-- Gradient Pulse Background -->
        <Rectangle id="pulseBg" width="1920" height="1080" color="0x0D1220FF" opacity="0.0" />
        <Animation id="pulseAnim" duration="8" repeat="true">
            <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[0.0, 1.0, 0.0]" fieldToInterp="pulseBg.opacity" />
        </Animation>

        <!-- Center Logo -->
        <Group id="logoGroup" translation="[760, 440]">
            <Label text="FamilyCare" font="font:LargeBoldSystemFont" color="0x00C9A7FF" />
            <Label text="Health · Wellness" font="font:MediumSystemFont" color="0x6B7280FF" translation="[0, 50]" />
        </Group>

        <!-- Logo Fade Animation -->
        <Animation id="logoFadeAnim" duration="10" repeat="true">
            <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[0.3, 1.0, 0.3]" fieldToInterp="logoGroup.opacity" />
        </Animation>

        <!-- Rotating text at bottom -->
        <Label id="tipLabel" text="" font="font:MediumSystemFont" color="0xF9FAFBFF" translation="[0, 900]" width="1920" horizAlign="center" />
        
        <!-- Timer to rotate tips every 15 seconds -->
        <Timer id="tipTimer" duration="15" repeat="true" />

        <Animation id="tipFadeAnim" duration="1" repeat="false">
            <FloatFieldInterpolator id="tipFader" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="tipLabel.opacity" />
        </Animation>
    </children>
</component>
